      "agent": ""
    },
    {
      "name": "CLAUDECODE alone is a human's IDE terminal too",
      "source": "shipped: Claude Code docs say IDE extensions set it in their integrated terminals",
      "platform": "darwin",
      "env": { "CLAUDECODE": "1", "TERM_PROGRAM": "vscode" },
      "agent": ""
