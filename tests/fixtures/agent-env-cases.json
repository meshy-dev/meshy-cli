{
  "description": "Environment of a command an AI agent runs -> the User-Agent's agent segment. Shared by every implementation of the detection: each case is the oracle, independent of the code. `source` says where the environment comes from: `captured` is a real run with only the marker variables kept (no ids, paths or users), `shipped` is read from the agent's released code or docs, `derived` combines documented markers to pin an ordering rule.",
  "cases": [
    {
      "name": "Claude Code inside the Claude desktop app",
      "source": "captured: Claude 4.23118.0, Claude Code 2.1.317, macOS",
      "platform": "darwin",
      "env": {
        "AI_AGENT": "claude-code_2-1-317_agent",
        "CLAUDECODE": "1",
        "CLAUDE_CODE_ENTRYPOINT": "claude-desktop",
        "CLAUDE_CODE_CHILD_SESSION": "1",
        "CLAUDE_CODE_DESKTOP_APP_VERSION": "4.23118.0",
        "CLAUDE_AGENT_SDK_VERSION": "0.3.317",
        "__CFBundleIdentifier": "com.anthropic.claudefordesktop"
      },
      "agent": "claude-code/desktop",
      "via": "CLAUDE_CODE_CHILD_SESSION"
    },
    {
      "name": "Claude Code CLI",
      "source": "shipped: Claude Code docs (env-vars) and binary",
      "platform": "linux",
      "env": { "CLAUDECODE": "1", "CLAUDE_CODE_CHILD_SESSION": "1", "CLAUDE_CODE_ENTRYPOINT": "cli", "AI_AGENT": "claude-code_2-1-317_agent" },
      "agent": "claude-code/cli"
    },
    {
      "name": "Claude Code recognised from AI_AGENT alone",
