    "credits": "both models: 5 mesh only; image-to-3d with 2K or 4K textures 15, with 8K textures 20",
    "refine": "a text-to-3d refine of a meshy-t2.5 preview works like one of a meshy-t2 preview",
    "decision": "D-079"
  },
