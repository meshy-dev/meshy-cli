  "sse_protocol": {
    "request": { "method": "GET", "path": "<resource>/<id>/stream", "headers": { "Accept": "text/event-stream", "Authorization": "Bearer <key>" } },
    "events": {
      "message": "data is the same task JSON as GET; re-emitted every ~10s as keep-alive even without progress change",
      "error": "data is {\"message\": string, \"status_code\": integer}; may arrive after HTTP 200; status_code is mapped like an HTTP status (404 -> not_found exit 5, 400 -> validation exit 4, 500 -> server exit 1)",
      "comment lines (':')": "ignored; treated as heartbeat for idle-timeout purposes",
      "unknown event names": "reported as a warning, never treated as task success"
    },
    "termination": "server closes after the first terminal message (SUCCEEDED/FAILED/CANCELED); the CLI also aborts the reader itself on terminal status",
    "reconnect": "not implemented in S1; recovery is `get`/`wait` with the same task id"
  },
