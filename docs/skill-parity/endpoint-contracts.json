    "creative-lab": { "default": "derived: <origin of v1 base>/openapi/creative-lab; explicit override required when v1 is a custom proxy path", "env": "MESHY_BASE_URL_CREATIVE_LAB", "flag": "--base-url-creative-lab", "auth": "bearer", "stored_profile_policy": "stored OAuth/API-key profiles are only sent when the creative-lab origin equals the v1 origin; a different origin requires an explicit --api-key / MESHY_API_KEY / --env-file key" },
    "public-web": { "default": "derived: <origin of v1 base>/web/public", "auth": "none", "notes": "never carries Authorization or cookies" }
  },
