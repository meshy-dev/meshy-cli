    "applies_to": ["image-to-3d", "text-to-3d (preview)"],
    "request": { "model_type": "smart-topology (required for these models)", "ai_model": { "enum": ["meshy-t2", "meshy-t2.5"], "default": "CLI sends meshy-t2.5; API omission still picks meshy-t2", "cli_flag": "--ai-model" }, "topology": "triangle only; quad is refused" },
